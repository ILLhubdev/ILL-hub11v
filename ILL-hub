-- ===== Dragging (mouse + touch) =====
-- The move listener only exists WHILE dragging (no per-mouse-move cost otherwise).
local moveConn
header.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local dragStart = input.Position
    local startPos = main.Position
    local startInput = input

    if moveConn then moveConn:Disconnect() end
    moveConn = UIS.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement
            or (i.UserInputType == Enum.UserInputType.Touch and i == startInput) then
            local d = i.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)

    local endConn
    endConn = input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            if moveConn then moveConn:Disconnect() moveConn = nil end
            endConn:Disconnect()
        end
    end)
end)

