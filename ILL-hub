-- ===== Core logic =====
local remoteCache = {}
-- deep = also search all of ReplicatedStorage (only used for the Training_Bonus event)
local function getRemote(name, deep)
    local r = remoteCache[name]
    if r and r.Parent then return r end
    local remotes = RS:FindFirstChild("Remotes")
    r = remotes and remotes:FindFirstChild(name)
    if not r and deep then
        r = RS:FindFirstChild(name, true)
    end
    remoteCache[name] = r
    return r
end

-- Cached character parts (only re-searched when the character changes)
local hrpCache, humCache
local function getHRP()
    local char = player.Character
    if not char then return nil end
    if not (hrpCache and hrpCache.Parent == char) then
        hrpCache = char:FindFirstChild("HumanoidRootPart")
        humCache = char:FindFirstChildOfClass("Humanoid")
    end
    if hrpCache and humCache and humCache.Health > 0 then
        return hrpCache
    end
    return nil
end

local function teleport(target, force)
    local hrp = getHRP()
    if not hrp then return false end
    if force or (hrp.Position - target).Magnitude > 2 then
        hrp.CFrame = CFrame.new(target)
    end
    return true
end

-- Smooth tween to a position (duration = distance / TweenSpeed).
-- Yields until the tween finishes or is cancelled, so call it from a task.
local activeTween
local function cancelTween()
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
end

local function tweenTo(target)
    local hrp = getHRP()
    if not hrp then return false end
    cancelTween()

    local dist = (hrp.Position - target).Magnitude
    if dist < 0.5 then return true end

    local duration = math.max(dist / math.max(Config.TweenSpeed, 1), 0.05)
    local goal = CFrame.new(target) * hrp.CFrame.Rotation -- keep facing direction
    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
    activeTween = tw
    tw:Play()
    tw.Completed:Wait()
    if activeTween == tw then activeTween = nil end
    return true
end

-- ===== Farm loop =====
local loopId = 0
local function startLoop()
    loopId += 1
    local myId = loopId
    local lastBeat = os.clock()

    local function running()
        return gui.Parent ~= nil and Config.Enabled and myId == loopId
    end

    -- Main loop: direct pcall'd remote calls (no extra threads/timers per call)
    task.spawn(function()
        local cycles, fails, runs = 0, 0, 0

        while running() do
            lastBeat = os.clock()

            local startR = getRemote("Throw_Start")
            local resolveR = getRemote("Throw_Resolve")
            local completeR = getRemote("Throw_Complete")

            if not (startR and resolveR and completeR) then
                setStatus("Remotes not found")
                task.wait(1)
                continue
            end

            if not getHRP() then
                setStatus("Waiting for character")
                task.wait(0.25)
                continue
            end

            if Config.Teleport and (Config.TeleportEveryCycle or runs == 0) then
                teleport(Config.Position)
            end

            runs += 1

            local ok1 = pcall(startR.InvokeServer, startR)
            if not running() then break end

            lastBeat = os.clock()
            task.wait(Config.ThrowDelay)
            if not running() then break end

            lastBeat = os.clock()
            local ok2 = pcall(resolveR.InvokeServer, resolveR, Config.ResolveValue)
            if not running() then break end

            local ok3 = pcall(completeR.InvokeServer, completeR)

            -- Equip best pets every N cycles, in the background (doesn't slow the loop)
            if Config.EquipBest and runs % Config.EquipEvery == 0 then
                local equipR = getRemote("Plot_EquipBest")
                if equipR then
                    task.spawn(pcall, equipR.InvokeServer, equipR)
                end
            end

            if ok1 and ok2 and ok3 then
                fails = 0
                cycles += 1
                if cycles % 10 == 1 then -- throttle label updates
                    setStatus("Farming (" .. cycles .. " cycles)")
                end
            else
                fails += 1
                if fails >= 5 then
                    setStatus("Errors - check remotes/position")
                    task.wait(1)
                end
            end

            task.wait(Config.CycleDelay)
        end

        if myId == loopId then setStatus("Idle") end
    end)

    -- Watchdog: if the server never answers, restart the loop (one cheap thread)
    task.spawn(function()
        while running() do
            task.wait(2)
            if running() and os.clock() - lastBeat > Config.ThrowDelay + Config.CycleDelay + 8 then
                setStatus("Stuck - restarting")
                startLoop()
                return
            end
        end
    end)
end

local function stopLoop()
    Config.Enabled = false
    loopId += 1
end

-- ===== Auto 2x bonus =====
-- The server fires Training_Bonus(id, timestamp) when the x2 button spawns.
-- We answer with Training_TapBonus(id). The id comes from the server, so it
-- restarts by itself every training session (nothing to reset).
local bonusConn
local fallbackId = 0 -- only used if the server ever sends a non-number id

local function stopBonus()
    if bonusConn then
        bonusConn:Disconnect()
        bonusConn = nil
    end
end

local function startBonus()
    if bonusConn then return end
    local ev = getRemote("Training_Bonus", true)
    if not ev then
        setStatus("Training_Bonus event not found")
        return
    end

    bonusConn = ev.OnClientEvent:Connect(function(id)
        local tapId = id
        if type(tapId) ~= "number" then
            fallbackId += 1
            tapId = fallbackId
        end

        task.spawn(function()
            if Config.BonusDelay > 0 then task.wait(Config.BonusDelay) end
            if not (Config.Training and Config.AutoBonus) then return end

            local r = getRemote("Training_TapBonus")
            if not r then
                setStatus("TapBonus remote not found")
                return
            end
            local ok, res = pcall(r.InvokeServer, r, tapId)
            setStatus("Bonus #" .. tostring(tapId) .. (ok and (" -> " .. tostring(res)) or " failed"))
        end)
    end)
end

local function refreshBonus()
    if Config.Training and Config.AutoBonus then
        startBonus()
    else
        stopBonus()
    end
end

-- ===== Auto train =====
-- ON: tween to the train position (no Training_Start). OFF: cancel tween + Training_Stop.
local function setTraining(on)
    Config.Training = on
    fallbackId = 0 -- fresh count for every session
    refreshBonus()
    if on then
        task.spawn(tweenTo, Config.TrainPosition)
    else
        cancelTween()
        task.spawn(function()
            local r = getRemote("Training_Stop")
            if r then pcall(r.InvokeServer, r) end
        end)
    end
end

-- ===== Anti-AFK =====
local afkConn
local function setAntiAfk(on)
    Config.AntiAfk = on
    if afkConn then
        afkConn:Disconnect()
        afkConn = nil
    end
    if on then
        afkConn = player.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end)
    end
end

-- ===== Copy current position =====
local function copyPosition(btn)
    local hrp = getHRP()
    local original = "Copy current position"
    if not hrp then
        btn.Text = "No character"
    else
        local p = hrp.Position
        local str = string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z)
        local clip = setclipboard or toclipboard or (syn and syn.write_clipboard)
        local ok = false
        if clip then ok = pcall(clip, str) end
        btn.Text = (ok and "Copied: " or "No clipboard: ") .. str
    end
    task.delay(2, function()
        if btn.Parent then btn.Text = original end
    end)
end

