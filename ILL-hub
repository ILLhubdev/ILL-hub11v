-- Number box bound to a Config key
local function numBox(page, label, key, min)
    return makeBox(page, label, Config[key], function(text, box)
        local n = tonumber(text)
        if n and n == n and n >= min and math.abs(n) < 1e9 then
            Config[key] = n
        end
        box.Text = tostring(Config[key])
    end)
end

local function fmtVec(v) return string.format("%g, %g, %g", v.X, v.Y, v.Z) end

local function parseVec(text)
    local nums = {}
    for s in string.gmatch(text, "[%-%d%.]+") do
        local n = tonumber(s)
        if n and n == n and math.abs(n) < 1e6 then
            nums[#nums + 1] = n
        end
    end
    if #nums == 3 then
        return Vector3.new(nums[1], nums[2], nums[3])
    end
    return nil
end

